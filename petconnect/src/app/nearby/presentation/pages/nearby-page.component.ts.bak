  /** Servicios con distancia real (geocodificada) respecto al usuario. */
  private readonly servicesWithDistance = computed(() => {
    const origin = this.userLocation();
    const geocoded = this.searchRadiusService.geocodedLocations();
    return this.services().map((service) => {
      const coords = geocoded[service.location.trim().toLowerCase()] ?? undefined;
      const distance =
        origin && coords ? this.searchRadiusService.distanceKm(origin, coords) : service.distance;
      return { ...service, distance };
    });
  });

  // Servicios filtrados por el radio global (Configuración) y tipo
  filteredServices = computed(() => {
    const radius = this.searchRadiusService.radiusKm();
    let services = this.servicesWithDistance().filter(s => s.distance <= radius);

    // Filtrar por tipo
    if (this.serviceType()) {
      services = services.filter(s => s.type === this.serviceType());
    }

    // Ordenar por distancia
    return services.sort((a, b) => a.distance - b.distance);
  });

  /** Geocodifica las direcciones de los servicios en segundo plano. */
  private readonly locationsEffect = effect(() => {
    const origin = this.userLocation();
    const services = this.services();
    if (!origin || !services.length) return;
    this.searchRadiusService.prefetchLocations(services.map(s => s.location));
  });

  /** Refleja el origen global (GPS/dirección del perfil) en la página. */
  private readonly originEffect = effect(() => {
    const origin = this.searchRadiusService.userOrigin();
    if (!origin) return;
    this.userLocation.set(origin);
    this.loading.set(false);
    const key = `${origin.lat.toFixed(4)},${origin.lng.toFixed(4)}`;
    if (key === this.lastReverseGeocodedKey) return;
    this.lastReverseGeocodedKey = key;
    this.geolocationService.reverseGeocode(origin.lat, origin.lng).subscribe({
      next: (result) => this.currentAddress.set(result.displayName),
      error: () => this.currentAddress.set(this.i18n.translate('nearby.currentLocation')),
    });
  });

  // Dark mode
  isDarkMode = signal(false);

  ngOnInit(): void {
    this.detectDarkMode();
    this.useCurrentLocation();
  }

  ngOnDestroy(): void {
    // Cleanup si es necesario
  }

  /**
   * Detecta el modo oscuro
   */
  private detectDarkMode(): void {
    const darkMode = document.documentElement.classList.contains('dark');
    this.isDarkMode.set(darkMode);

    const observer = new MutationObserver(() => {
      this.isDarkMode.set(document.documentElement.classList.contains('dark'));
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }

  /**
   * Usa la ubicación de referencia global (GPS con fallback a la dirección
   * guardada en el perfil). El effect `originEffect` sincroniza el estado.
   */
  useCurrentLocation(): void {
    this.loading.set(true);
    this.error.set(null);

    this.searchRadiusService.resolveOrigin(true).subscribe({
      next: (coords) => {
        this.loading.set(false);
        if (!coords) {
          const message =
            this.searchRadiusService.originError() ??
            this.i18n.translate('nearby.locationError') ??
            '';
          this.error.set(message);
          this.messageService.add({
            severity: 'error',
            summary: this.i18n.translate('nearby.locationErrorTitle'),
            detail: message
          });
        }
      },
      error: (err) => {
        console.error(this.i18n.translate('nearby.locationError'), err);
        this.error.set(err.message);
        this.loading.set(false);
        this.messageService.add({
          severity: 'error',
          summary: this.i18n.translate('nearby.locationErrorTitle'),
          detail: err.message
        });
      }
    });
  }

  /**
   * Obtiene la etiqueta del tipo de servicio
   */
  getServiceTypeLabel(type: string): string {
    const labels: Record<string, string> = {
      vet: 'Veterinario',
      shelter: 'Protectora',
      event: 'Evento'
    };
    return labels[type] || type;
  }
}
